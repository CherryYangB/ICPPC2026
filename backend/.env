DATABASE_URL="file:./dev.db"

PORT=3000
NODE_ENV=development

CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://localhost:3000"

GLOBAL_RATE_LIMIT=120
GLOBAL_RATE_TTL_MS=60000
ANSWER_RATE_LIMIT=20
ANSWER_RATE_TTL_MS=60000
ANSWER_COOLDOWN_MS=30000

# 总览 onlineCount：最近 N 分钟内有答题的去重 clientIp
ONLINE_WINDOW_MINUTES=10

SCREEN_TOKEN=

# 后台管理 JWT：生产环境务必替换为随机长串（openssl rand -hex 32）
JWT_SECRET="icppc2026-admin-dev-secret-4f8c2d1a9b7e6f3c5a0d8e2b7c1f4a9d"
JWT_EXPIRES_IN=8h

# 登录接口限流（默认 5 次 / 分钟）
LOGIN_RATE_LIMIT=5
LOGIN_RATE_TTL_MS=60000

TRUST_PROXY=1

SWAGGER_ENABLED=true