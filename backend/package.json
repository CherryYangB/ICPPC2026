{
  "name": "icppc2026-backend",
  "version": "0.0.1",
  "description": "ICPPC 2026 conference interaction system backend",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19 <23"
  },
  "scripts": {
    "postinstall": "node scripts/prisma-postinstall.mjs",
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "prestart:dev": "prisma generate",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy && prisma db seed",
    "prisma:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "clean:institutions": "tsx scripts/clean-institutions.ts",
    "parse:domain-words": "tsx scripts/parse-domain-words.ts",
    "seed:demo": "tsx scripts/seed-demo-answers.ts",
    "seed:institutions": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.0.0",
    "@node-rs/jieba": "^2.0.4",
    "@prisma/client": "^6.19.3",
    "@prisma/engines": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mammoth": "^1.13.0",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "xlsx": "^0.18.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@scarf/scarf": true,
    "esbuild": true,
    "@prisma/engines": true,
    "prisma": true
  }
}
