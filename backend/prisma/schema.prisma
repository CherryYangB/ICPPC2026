generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 八问：主键与前端 QUESTION_IDS 完全一致（'q1'..'q8'）
model Question {
  id        String   @id // q1..q8
  order     Int      @unique // 1..8
  topicZh   String
  topicEn   String
  titleZh   String
  titleEn   String
  color     String // #RRGGBB
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers Answer[]
}

// 答题记录：字段名与前端 SubmitAnswerRequest 一致
model Answer {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  identityTag String // physician | nurse | ...
  answer      String // 1..100 字符
  clientIp    String? // 仅审计，不返回、不广播
  // 后台隐藏：词云、弹幕回放、答题数、参与人数均过滤 isHidden = true
  isHidden    Boolean  @default(false)
  submittedAt DateTime @default(now())

  @@index([questionId, submittedAt])
  @@index([identityTag, submittedAt])
  @@index([clientIp, questionId, submittedAt])
}

// 后台账号：角色 super_admin / admin / viewer（SQLite 不用 enum，应用层白名单校验）
model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  passwordHash       String
  displayName        String
  role               String // super_admin / admin / viewer
  email              String?
  isActive           Boolean   @default(true)
  // 首次登录 / 管理员重置密码后强制改密；前端据此跳转改密页
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// 机构：由 backend/scripts/clean-institutions.ts 从 Excel 清洗生成（prisma/seed-data/institutions.json）
model Institution {
  id                Int      @id @default(autoincrement())
  province          String // 短名，如「广东」「内蒙古」
  city              String // 保留源表写法，如「深圳市」
  nameZh            String
  nameEn            String?
  hasWard           Boolean  @default(false)
  hasClinic         Boolean  @default(false)
  wardProjects      Json     @default("[]")
  clinicDepartments Json     @default("[]")
  typeTags          Json     @default("[]") // ['ward'] | ['clinic'] | ['ward','clinic']
  longitude         Float
  latitude          Float
  address           String?
  description       String?
  descriptionEn     String?
  isLit             Boolean  @default(false)
  litAt             DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  checkins CheckinRecord[]

  @@unique([province, city, nameZh])
  @@index([province])
}

// 打卡历史：用于总览「最近活动」；删除机构时级联删除
model CheckinRecord {
  id            Int         @id @default(autoincrement())
  institutionId Int
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  province      String
  city          String
  nameZh        String
  checkedAt     DateTime    @default(now())

  @@index([checkedAt])
  @@index([institutionId])
}
