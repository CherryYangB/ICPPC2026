# Prisma: path is relative to prisma/schema.prisma -> backend/prisma/dev.db
DATABASE_URL="file:./dev.db"

PORT=3000
NODE_ENV=development

# Comma-separated list of allowed origins (REST + WebSocket)
# 5173 = H5 dev，5174 = 大屏 dev（Screen 走 Vite 代理时同源，不触发 CORS；直连 3000 时需要）
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://localhost:3000"

# Rate limiting
GLOBAL_RATE_LIMIT=120
GLOBAL_RATE_TTL_MS=60000
ANSWER_RATE_LIMIT=20
ANSWER_RATE_TTL_MS=60000
ANSWER_COOLDOWN_MS=30000

# 同一机构重复打卡的防刷窗口（毫秒）
CHECKIN_COOLDOWN_MS=10000

# 总览 onlineCount：最近 N 分钟内有答题的去重 clientIp
ONLINE_WINDOW_MINUTES=10

# Optional: token required by large-screen clients in socket handshake auth
SCREEN_TOKEN=

# 后台管理 JWT（必填，至少 32 位；生产环境用 openssl rand -hex 32 生成）
JWT_SECRET="please-change-this-to-a-random-string-at-least-32-chars"
JWT_EXPIRES_IN=8h

# 登录接口限流（默认 5 次 / 分钟）
LOGIN_RATE_LIMIT=5
LOGIN_RATE_TTL_MS=60000

# Trust the first proxy hop so client IP detection works behind nginx
TRUST_PROXY=1

# OpenAPI docs
SWAGGER_ENABLED=true